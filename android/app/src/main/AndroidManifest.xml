<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.vulkan.version" android:version="0x403000" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.gamepad" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <!-- the part of the game that listens for the word -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- the update check and download (Updater.java), and handing the downloaded APK to Android's installer -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:allowBackup="false"
        android:label="P.T. PC Port"
        android:hasCode="true"
        android:extractNativeLibs="true"
        android:largeHeap="true"
        android:requestLegacyExternalStorage="false"
        android:theme="@android:style/Theme.NoTitleBar.Fullscreen">

        <!-- the launcher: checks for the game files, asks for them when they are missing, then starts the game -->
        <activity
            android:name=".ImportActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|uiMode"
            android:theme="@android:style/Theme.Material.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- the second icon: picture size, quality preset and the log (ToolsActivity.java) -->
        <activity
            android:name=".ToolsActivity"
            android:exported="true"
            android:label="P.T. tools"
            android:theme="@android:style/Theme.Material.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".PTActivity"
            android:exported="false"
            android:label="P.T."
            android:alwaysRetainTaskState="true"
            android:launchMode="singleTask"
            android:screenOrientation="sensorLandscape"
            android:preferMinimalPostProcessing="true"
            android:configChanges="layoutDirection|locale|orientation|uiMode|screenLayout|screenSize|smallestScreenSize|keyboard|keyboardHidden|navigation" />
    </application>
</manifest>
