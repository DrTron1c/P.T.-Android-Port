#version 460

// The built-in temporal upscaler (src/engine/render/upscale/builtin_backend.cpp): a compute shader that runs on any Vulkan GPU, the
// one upscaler of the Android build (FSR 3, DLSS and XeSS ship as Windows DLLs, MetalFX is Apple's).
//
// Mode 0 resolves one frame. The scene was drawn at the render size with the projection shifted by the frame's jitter, so the
// render image shows the display pixel at uv at  uv * render + jitter  (render pixels, pixel i centred at i + 0.5). Each display
// pixel
//   1. gathers the 3x3 render pixels around that position, weighted by a Gaussian of their distance (the new samples),
//   2. takes the motion vector of the nearest of the nine (reverse-Z: the largest depth) and reads last frame's output at
//      uv + motion with a Catmull-Rom filter (the history),
//   3. clips the history to the colour range of the nine (mean +- sigma in YCoCg), so what the surface no longer shows is
//      dropped instead of smeared, and
//   4. blends the two in a space where bright pixels weigh less (c / (1 + luma)), more of the new samples where the engine
//      marked the pixel reactive (the flashlight beam), the clip cut a lot of the history, or the motion is fast.
// The result is the frame's output and the next frame's history. The history is stored divided by the exposure of its frame
// (scene-referred), so the auto exposure changing between frames neither shifts the picture nor loses precision in a dark scene.
//
// Mode 1 sharpens the history just written into the output (a contrast adaptive sharpen after the resolve).

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0) uniform sampler2D u_color;
layout(set = 0, binding = 1) uniform sampler2D u_depth;
layout(set = 0, binding = 2) uniform sampler2D u_motion;
layout(set = 0, binding = 3) uniform sampler2D u_reactive;
layout(set = 0, binding = 4) uniform sampler2D u_history;
layout(set = 0, binding = 5, rgba16f) uniform writeonly image2D u_history_out;
layout(set = 0, binding = 6, rgba16f) uniform writeonly image2D u_output;

layout(push_constant) uniform Push {
    uvec4 sizes;  // render width, height, display width, height
    vec4 a;       // jitter x, y (render pixels), exposure of this frame, the history's weight at rest
    vec4 b;       // sharpness, reset (1: no history), mode, test view (0: none)
} pc;

const float kMaxValue = 60000.0;

bool Finite(float x) {
    // bit test: Adreno's compiler does not keep NaN semantics in float comparisons or isnan
    return (floatBitsToUint(x) & 0x7F800000u) != 0x7F800000u;
}

vec3 Sane(vec3 c) {
    if (!(Finite(c.x) && Finite(c.y) && Finite(c.z))) {
        return vec3(0.0);
    }
    return clamp(c, vec3(0.0), vec3(kMaxValue));
}

float Luma(vec3 c) {
    return dot(c, vec3(0.2126, 0.7152, 0.0722));
}

vec3 Compress(vec3 c) {
    return c / (1.0 + Luma(c));
}

vec3 Decompress(vec3 c) {
    return c / max(1.0 - Luma(c), 1.0 / 65536.0);
}

vec3 ToYCoCg(vec3 c) {
    return vec3(0.25 * c.r + 0.5 * c.g + 0.25 * c.b, 0.5 * c.r - 0.5 * c.b, -0.25 * c.r + 0.5 * c.g - 0.25 * c.b);
}

vec3 FromYCoCg(vec3 c) {
    return vec3(c.x + c.y - c.z, c.x + c.z, c.x - c.y - c.z);
}

// Catmull-Rom through five bilinear taps (the corners' weights are small and left out); the history is read in display pixels
vec4 SampleHistory(vec2 uv) {
    vec2 size = vec2(pc.sizes.zw);
    vec2 pos = uv * size;
    vec2 centre = floor(pos - 0.5) + 0.5;
    vec2 f = pos - centre;
    vec2 w0 = f * (-0.5 + f * (1.0 - 0.5 * f));
    vec2 w1 = 1.0 + f * f * (-2.5 + 1.5 * f);
    vec2 w2 = f * (0.5 + f * (2.0 - 1.5 * f));
    vec2 w3 = f * f * (-0.5 + 0.5 * f);
    vec2 w12 = w1 + w2;
    vec2 t12 = (centre + w2 / w12) / size;
    vec2 t0 = (centre - 1.0) / size;
    vec2 t3 = (centre + 2.0) / size;
    vec4 sum = textureLod(u_history, vec2(t12.x, t0.y), 0.0) * (w12.x * w0.y) + textureLod(u_history, vec2(t0.x, t12.y), 0.0) * (w0.x * w12.y) +
               textureLod(u_history, vec2(t12.x, t12.y), 0.0) * (w12.x * w12.y) + textureLod(u_history, vec2(t3.x, t12.y), 0.0) * (w3.x * w12.y) +
               textureLod(u_history, vec2(t12.x, t3.y), 0.0) * (w12.x * w3.y);
    float weight = w12.x * w0.y + w0.x * w12.y + w12.x * w12.y + w3.x * w12.y + w12.x * w3.y;
    return sum / max(weight, 1.0e-4);
}

// q clipped onto the box lo..hi along the line to the box's centre
vec3 ClipToBox(vec3 lo, vec3 hi, vec3 q, out float outside) {
    vec3 centre = 0.5 * (hi + lo);
    vec3 extent = 0.5 * (hi - lo) + 1.0e-4;
    vec3 v = q - centre;
    vec3 a = abs(v / extent);
    float m = max(a.x, max(a.y, a.z));
    outside = m;
    return m > 1.0 ? centre + v / m : q;
}

void Resolve(ivec2 px) {
    ivec2 render = ivec2(pc.sizes.xy);
    vec2 display = vec2(pc.sizes.zw);
    vec2 uv = (vec2(px) + 0.5) / display;
    float exposure = max(pc.a.z, 1.0e-12);
    vec2 rc = uv * vec2(render) + pc.a.xy;
    ivec2 nearest = ivec2(floor(rc));

    vec3 sum = vec3(0.0);
    float sum_alpha = 0.0;
    float sum_weight = 0.0;
    vec3 m1 = vec3(0.0);
    vec3 m2 = vec3(0.0);
    vec3 mn = vec3(1.0e9);
    vec3 mx = vec3(-1.0e9);
    float reactive = 0.0;
    float closest = -1.0;
    ivec2 closest_tap = clamp(nearest, ivec2(0), render - 1);
    for (int dy = -1; dy <= 1; ++dy) {
        for (int dx = -1; dx <= 1; ++dx) {
            ivec2 tap_raw = nearest + ivec2(dx, dy);
            ivec2 tap = clamp(tap_raw, ivec2(0), render - 1);
            vec2 delta = vec2(tap_raw) + 0.5 - rc;
            float w = exp(-3.0 * dot(delta, delta));
            vec4 s = texelFetch(u_color, tap, 0);
            vec3 c = Compress(Sane(s.rgb));
            sum += c * w;
            sum_alpha += (Finite(s.a) ? clamp(s.a, 0.0, 1.0) : 0.0) * w;
            sum_weight += w;
            vec3 y = ToYCoCg(c);
            m1 += y;
            m2 += y * y;
            mn = min(mn, y);
            mx = max(mx, y);
            reactive = max(reactive, texelFetch(u_reactive, tap, 0).x);
            float depth = texelFetch(u_depth, tap, 0).x;
            if (depth > closest) {
                closest = depth;
                closest_tap = tap;
            }
        }
    }
    vec3 current = sum / sum_weight;
    float current_alpha = sum_alpha / sum_weight;

    vec2 motion = texelFetch(u_motion, closest_tap, 0).xy;
    if (!(Finite(motion.x) && Finite(motion.y))) {
        motion = vec2(0.0);
    }
    motion = clamp(motion, vec2(-1.0), vec2(1.0));
    vec2 history_uv = uv + motion;

    vec3 result = current;
    float result_alpha = current_alpha;
    bool have_history = pc.b.y < 0.5 && all(greaterThanEqual(history_uv, vec2(0.0))) && all(lessThan(history_uv, vec2(1.0)));
    if (have_history) {
        vec4 history = SampleHistory(history_uv);
        history.rgb = Compress(Sane(max(history.rgb, vec3(0.0)) * exposure));
        // the mean and spread of the nine, the box the history may stay in
        vec3 mean = m1 / 9.0;
        vec3 sigma = sqrt(max(m2 / 9.0 - mean * mean, vec3(0.0)));
        vec3 lo = max(mean - 1.15 * sigma, mn);
        vec3 hi = min(mean + 1.15 * sigma, mx);
        float outside;
        vec3 clipped = FromYCoCg(ClipToBox(min(lo, hi), max(lo, hi), ToYCoCg(history.rgb), outside));

        // the weight of the new samples: the rest value, up with the motion (a resampled history is soft), the reactive mask
        // (the flashlight beam) and the clip (the history showed another surface)
        float rest = clamp(pc.a.w, 0.02, 0.5);
        float speed = length(motion * display);
        float weight = rest;
        weight = max(weight, clamp(speed * 0.04, 0.0, 0.25));
        weight = max(weight, clamp((outside - 1.0) * 0.5, 0.0, 1.0) * 0.6);
        weight = mix(weight, 0.7, clamp(reactive, 0.0, 1.0));
        result = mix(clipped, current, weight);
        result_alpha = mix(clamp(history.a, 0.0, 1.0), current_alpha, weight);
    }

    vec3 colour = min(Decompress(result), vec3(kMaxValue));
    imageStore(u_output, px, vec4(colour, result_alpha));
    imageStore(u_history_out, px, vec4(min(colour / exposure, vec3(kMaxValue)), result_alpha));
}

void Sharpen(ivec2 px) {
    ivec2 size = ivec2(pc.sizes.zw);
    float exposure = max(pc.a.z, 1.0e-12);
    vec4 centre = texelFetch(u_history, px, 0);
    vec3 c = Compress(Sane(centre.rgb * exposure));
    vec3 n = Compress(Sane(texelFetch(u_history, clamp(px + ivec2(0, -1), ivec2(0), size - 1), 0).rgb * exposure));
    vec3 s = Compress(Sane(texelFetch(u_history, clamp(px + ivec2(0, 1), ivec2(0), size - 1), 0).rgb * exposure));
    vec3 e = Compress(Sane(texelFetch(u_history, clamp(px + ivec2(1, 0), ivec2(0), size - 1), 0).rgb * exposure));
    vec3 w = Compress(Sane(texelFetch(u_history, clamp(px + ivec2(-1, 0), ivec2(0), size - 1), 0).rgb * exposure));
    // contrast adaptive sharpening (AMD CAS) on the compressed colour, which is within 0..1: less where the neighbourhood is
    // already near black or white, so edges do not ring
    vec3 mn = min(c, min(min(n, s), min(e, w)));
    vec3 mx = max(c, max(max(n, s), max(e, w)));
    vec3 amp = sqrt(clamp(min(mn, 1.0 - mx) / max(mx, vec3(1.0e-4)), vec3(0.0), vec3(1.0)));
    vec3 weight = amp * (-0.2 * clamp(pc.b.x, 0.0, 1.0));
    vec3 sharp = (c + (n + s + e + w) * weight) / (1.0 + 4.0 * weight);
    vec3 colour = min(Decompress(max(sharp, vec3(0.0))), vec3(kMaxValue));
    imageStore(u_output, px, vec4(colour, centre.a));
}

// Test views for finding out why a picture goes wrong on a GPU nobody has tried (pc.b.w, the Android settings panel's Upscaler test
// view): each writes one thing the upscaler reads, or a pattern that does not depend on any input, straight to the output
void DebugView(ivec2 px) {
    ivec2 render = ivec2(pc.sizes.xy);
    vec2 display = vec2(pc.sizes.zw);
    vec2 uv = (vec2(px) + 0.5) / display;
    float exposure = max(pc.a.z, 1.0e-12);
    ivec2 rp = clamp(ivec2(uv * vec2(render)), ivec2(0), render - 1);
    int mode = int(pc.b.w + 0.5);
    vec3 c = vec3(0.0);
    if (mode == 1) {
        // a pattern from the pixel position alone: a band of 64 rows in each of six colours (red, green, yellow, blue, magenta, cyan,
        // then round again), every 64 pixel column alternately dim, a white line across every 256th row and a white frame around
        // the display, so a photo of the screen shows how many rows and columns reach it and at what scale
        int band = ((px.y >> 6) % 6) + 1;
        c = vec3(float(band & 1), float((band >> 1) & 1), float((band >> 2) & 1)) * 0.5;
        if (((px.x >> 6) & 1) == 0) {
            c *= 0.6;
        }
        if ((px.y & 255) < 3) {
            c = vec3(0.5);
        }
        ivec2 size = ivec2(pc.sizes.zw);
        if (px.x < 4 || px.y < 4 || px.x >= size.x - 4 || px.y >= size.y - 4) {
            c = vec3(0.5);
        }
    } else if (mode == 2) {
        c = Sane(texelFetch(u_color, rp, 0).rgb);
    } else if (mode == 3) {
        vec2 m = texelFetch(u_motion, rp, 0).xy;
        if (!(Finite(m.x) && Finite(m.y))) {
            m = vec2(0.0);
        }
        c = vec3(0.25 + 20.0 * m, 0.1);
    } else if (mode == 4) {
        float d = texelFetch(u_depth, rp, 0).x;
        c = vec3(Finite(d) ? clamp(d * 12.0, 0.0, 1.0) : 1.0) * 0.5;
    } else if (mode == 5) {
        c = Sane(SampleHistory(uv).rgb * exposure);
    } else if (mode == 6) {
        c = vec3(texelFetch(u_reactive, rp, 0).x) * 0.5;
    }
    imageStore(u_output, px, vec4(c, 1.0));
}

void main() {
    ivec2 px = ivec2(gl_GlobalInvocationID.xy);
    if (px.x >= int(pc.sizes.z) || px.y >= int(pc.sizes.w)) {
        return;
    }
    if (pc.b.w > 0.5) {
        DebugView(px);
    } else if (pc.b.z < 0.5) {
        Resolve(px);
    } else {
        Sharpen(px);
    }
}
