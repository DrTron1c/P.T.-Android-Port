#version 460

// The built-in temporal upscaler as a compute shader (src/engine/render/upscale/builtin_backend.cpp), one of its two ways of running:
// builtin_upscale.frag makes the same picture with a full screen draw, which is the one the Android build uses, because the first GPU
// it was tried on (an Adreno 740) wrote only the top 128 rows of a compute shader's output. What each pass does is in
// builtin_upscale.glsl.

layout(local_size_x = 8, local_size_y = 8) in;

#include "builtin_upscale.glsl"

layout(set = 0, binding = 5, rgba16f) uniform writeonly image2D u_history_out;
layout(set = 0, binding = 6, rgba16f) uniform writeonly image2D u_output;
// what the groups that ran counted (the CPU reads it back): groups run, the furthest group row and column, groups per 64th of the rows
layout(set = 0, binding = 7, std430) buffer Counters {
    uint groups_run;
    uint last_row;
    uint last_column;
    uint spare;
    uint bands[64];
} counters;
// the picture as RGBA16F pixels, two words each, for the output path that copies a buffer into the engine's image
layout(set = 0, binding = 8, std430) buffer OutputPixels {
    uvec2 pixels[];
} out_pixels;

void StoreOutput(ivec2 px, vec4 colour) {
    if (ToBuffer()) {
        out_pixels.pixels[uint(px.y) * pc.sizes.z + uint(px.x)] = uvec2(packHalf2x16(colour.rg), packHalf2x16(colour.ba));
    } else {
        imageStore(u_output, px, colour);
    }
}

void main() {
    if (gl_LocalInvocationIndex == 0u) {
        // one count for each work group that starts: whether the whole dispatch runs
        atomicAdd(counters.groups_run, 1u);
        atomicMax(counters.last_row, gl_WorkGroupID.y);
        atomicMax(counters.last_column, gl_WorkGroupID.x);
        uint rows = max((pc.sizes.w + 7u) / 8u, 1u);
        atomicAdd(counters.bands[min(63u, gl_WorkGroupID.y * 64u / rows)], 1u);
    }
    ivec2 px = ivec2(gl_GlobalInvocationID.xy);
    if (px.x >= int(pc.sizes.z) || px.y >= int(pc.sizes.w)) {
        return;
    }
    if (pc.b.w > 0.5) {
        StoreOutput(px, DebugPixel(px));
    } else if (Pass() == 0) {
        vec4 history_value;
        vec4 colour = ResolvePixel(px, history_value);
        StoreOutput(px, colour);
        imageStore(u_history_out, px, history_value);
    } else {
        StoreOutput(px, SharpenPixel(px));
    }
}
